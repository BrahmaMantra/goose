# 显示所有命令、用途与参数；不执行浏览器或模型任务
default:
    @just --list

[doc('准备本地 CLI，并打开或复用专用浏览器；不调用模型')]
prepare:
    @./BM_douyin prepare --open-browser

[doc('检查本地配置和工具依赖；不读取账号、不调用模型')]
doctor:
    @./BM_douyin doctor

[doc('打开抖音专用浏览器，复用独立登录资料；需要时在官方页面扫码')]
browser-open:
    @./BM_douyin browser open

[doc('关闭抖音专用浏览器；保留本地登录资料，不退出抖音账号')]
browser-close:
    @./BM_douyin browser close

[doc('读取页面上的账号状态；真实值存本地，终端仅显示脱敏摘要；不调用模型')]
account:
    @./BM_douyin account check

[doc('读取当前已加载的少量作品，数量1～10；真实值存本地；不调用模型')]
works limit="3":
    @./BM_douyin works list --limit {{quote(limit)}}

[doc('通过 Goose 验证 Plugin MCP；参数 account/works，作品最多3条；不调用模型')]
probe tool="account":
    @./BM_douyin goose probe {{quote(tool)}}

[doc('将带引号的任务交给 Goose + LLM；只读工具，作品最多3条；按模型服务计费')]
agent task:
    @./BM_douyin agent run {{quote(task)}}

[doc('查看最近本地结果；参数 works/account/agent；会显示个人数据，不抓取、不调用模型')]
results kind="works":
    @./BM_douyin results {{quote(kind)}}

[doc('进入 Goose 原生模型配置；不执行任务，可能查询模型服务元数据')]
configure:
    @./BM_douyin goose configure

[doc('使用 Goose 校验独立 Recipe；不读取账号、不调用模型')]
validate:
    @./BM_douyin goose validate

[doc('运行合成回归；不读取账号与模型配置、不启动浏览器、不调用模型')]
test:
    @./BM_douyin test

[doc('用真实 Goose、回环模拟响应与合成 MCP 验证 Plugin；不调用模型或抖音')]
test-native:
    @./BM_douyin test --native
