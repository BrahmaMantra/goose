# 显示所有命令、用途与参数；不执行浏览器或模型任务
default:
    @just --list

repo_dir := parent_directory(justfile_directory())
goose_cli_features := "code-mode,rustls-tls,tree-sitter,live-voice,aws-providers,telemetry,otel,bundled-mcp,scheduler,platform-apps,chat-recall,acp-http,online-model-meta"

[doc('准备本地 CLI，并打开或复用专用浏览器；不调用模型')]
prepare:
    @just --justfile BM_douyin/Justfile prepare

[doc('检查本地配置和工具依赖；不读取账号、不调用模型')]
doctor:
    @just --justfile BM_douyin/Justfile doctor

[doc('打开抖音专用浏览器，复用独立登录资料；需要时在官方页面扫码')]
browser-open:
    @just --justfile BM_douyin/Justfile browser-open

[doc('关闭抖音专用浏览器；保留本地登录资料，不退出抖音账号')]
browser-close:
    @just --justfile BM_douyin/Justfile browser-close

[doc('读取页面上的账号状态；真实值存本地，终端仅显示脱敏摘要；不调用模型')]
account:
    @just --justfile BM_douyin/Justfile account

[doc('读取当前已加载的少量作品，数量1～10；真实值存本地；不调用模型')]
works limit="3":
    @just --justfile BM_douyin/Justfile works {{quote(limit)}}

[doc('通过 Goose 验证 Plugin MCP；参数 account/works，作品最多3条；不调用模型')]
probe tool="account":
    @just --justfile BM_douyin/Justfile probe {{quote(tool)}}

[doc('将带引号的任务交给 Goose + LLM；只读工具，作品最多3条；按模型服务计费')]
agent task:
    @just --justfile BM_douyin/Justfile agent {{quote(task)}}

[doc('查看最近本地结果；参数 works/account/agent；会显示个人数据，不抓取、不调用模型')]
results kind="works":
    @just --justfile BM_douyin/Justfile results {{quote(kind)}}

[doc('进入 Goose 原生模型配置；不执行任务，可能查询模型服务元数据')]
configure:
    @just --justfile BM_douyin/Justfile configure

[doc('使用 Goose 校验独立 Recipe；不读取账号、不调用模型')]
validate:
    @just --justfile BM_douyin/Justfile validate

[doc('运行合成回归；不读取账号与模型配置、不启动浏览器、不调用模型')]
test:
    @just --justfile BM_douyin/Justfile test

[doc('用真实 Goose、回环模拟响应与合成 MCP 验证 Plugin；不调用模型或抖音')]
test-native:
    @just --justfile BM_douyin/Justfile test-native

[doc('用源码编译 debug Goose CLI；关闭进程内本地推理，外部 Ollama/OpenAI 兼容模型不受影响；不调用模型')]
build_goose_cli_debug:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_dir}}"
    source bin/activate-hermit
    cargo build -p goose-cli --bin goose --no-default-features --features "{{goose_cli_features}}"
    target/debug/goose --version

[doc('编译 debug Goose CLI 并启动 Electron 桌面开发版；首次会安装 pnpm 依赖；不调用模型')]
build_goose_desk_debug: build_goose_cli_debug
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_dir}}"
    mkdir -p ui/desktop/src/bin
    install -m 0755 target/debug/goose ui/desktop/src/bin/goose
    source bin/activate-hermit
    cd ui/desktop
    pnpm install
    pnpm run start-gui
